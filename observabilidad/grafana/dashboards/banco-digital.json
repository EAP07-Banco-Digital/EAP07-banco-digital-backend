    {
      "id": 10,
      "type": "timeseries",
      "title": "Seguridad: 401 y 403 por endpoint (por minuto)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (status, uri) (rate(http_server_requests_seconds_count{application=\"banco-digital-backend\", uri!~\"/actuator.*|/swagger.*|/v3/api-docs.*\", status=~\"401|403|423|429\"}[1m]))*60",
          "legendFormat": "{{status}} {{uri}}"
